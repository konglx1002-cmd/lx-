generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Diary {
  id             String   @id @default(cuid())
  date           DateTime @unique
  completedTasks String
  problems       String
  nextPlan       String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
