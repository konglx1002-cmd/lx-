# Runtime database connection. Use the pooled URL supplied by the PostgreSQL provider.
DATABASE_URL="postgresql://APP_USER:APP_PASSWORD@POOL_HOST:5432/APP_DATABASE?schema=public&sslmode=require"

# Direct database connection reserved for migrations and administrative operations.
DIRECT_URL="postgresql://MIGRATION_USER:MIGRATION_PASSWORD@DIRECT_HOST:5432/APP_DATABASE?schema=public&sslmode=require"

# Replace with a high-entropy secret of at least 32 characters.
BETTER_AUTH_SECRET="replace-with-a-production-secret-of-at-least-32-characters"

# Canonical HTTPS origin of the deployed application.
BETTER_AUTH_URL="https://your-domain.example.com"
